# backend/.env for PRODUCTION. Copy to the server as /var/www/sunates/backend/.env (mode 640, owner
# www-data) and fill in the blanks there. Never commit the filled-in file. Values marked <...> are secrets
# held by the Directorate of ICT; see docs/handover.md for where each comes from.
# Staging uses the same file with APP_ENV=staging, its own database, and SANDBOX messaging credentials only.

APP_NAME=SUN-ATES
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                  # php artisan key:generate --show (once; changing it breaks encrypted data)
APP_URL=https://alumni.example.ac.ug
SUNATES_PWA_URL=https://alumni.example.ac.ug
SUNATES_TIMEZONE=Africa/Kampala

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sunates
DB_USERNAME=sunates
DB_PASSWORD=<database password>

# Spec section 9: HTTPS throughout. Cookies only over HTTPS; the PWA is served from the same origin.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://alumni.example.ac.ug

QUEUE_CONNECTION=database
CACHE_STORE=database
BCRYPT_ROUNDS=12

# Password-reset and registration-code emails (alumni). Use the university's SMTP relay.
MAIL_MAILER=smtp
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_FROM_ADDRESS=alumni@soroti.ac.ug
MAIL_FROM_NAME="Soroti University Alumni"

# Messaging: "log" sends nothing. Switch to mtn / cloud only once credentials are confirmed with the
# console's "Send a test message" form (README, "Going live with MTN SMS and WhatsApp").
SMS_DRIVER=log
WHATSAPP_DRIVER=log
MTN_SMS_CLIENT_ID=<from developers.mtn.com>
MTN_SMS_CLIENT_SECRET=<from developers.mtn.com>
MTN_SMS_SENDER=<approved sender id>
MTN_SMS_CALLBACK_SECRET=<48 random characters; part of the callback URL given to MTN>
WHATSAPP_PHONE_NUMBER_ID=<from Meta Business Manager>
WHATSAPP_ACCESS_TOKEN=<system-user token>
WHATSAPP_VERIFY_TOKEN=<a random string you also enter in Meta>
WHATSAPP_APP_SECRET=<Meta app secret>
WHATSAPP_TEMPLATE_REGISTRATION_CODE=sunates_registration_code

# Contact policy: decide in the data-protection review (README, "To confirm").
SURVEY_INCLUDE_UNCLAIMED=false
NUDGES_INCLUDE_UNCLAIMED=false

# Retention (days). Confirm with the data-protection review.
VERIFICATION_LOG_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=1095

ERP_DRIVER=none
