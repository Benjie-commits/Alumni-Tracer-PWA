APP_NAME=SUN-ATES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sunates
DB_USERNAME=sunates
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SUN-ATES: alumni app, surveys and messaging (Phase 2) ---------------------------------------
# Where links in SMS/WhatsApp messages point (the alumni PWA). Use https in production.
SUNATES_PWA_URL=http://127.0.0.1:5173
# Origins allowed to call the API from a browser (comma separated). Not needed when the PWA is
# served from the same origin as the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "log" writes messages to the Laravel log and sends nothing (safe for development and CI).
# Go live with SMS_DRIVER=mtn and WHATSAPP_DRIVER=cloud once the credentials below are filled in.
# Note: the log drivers record the message text, including the private survey link, so never use
# them in production.
SMS_DRIVER=log
WHATSAPP_DRIVER=log

# MTN SMS API (developers.mtn.com). Sandbox first, then production.
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER=
# MTN_SMS_BASE_URL=https://api.mtn.com/v1/messages
# MTN_SMS_TOKEN_URL=https://api.mtn.com/oauth/client_credential/accesstoken

# WhatsApp Business Platform, Cloud API (Meta). Templates must be approved in Meta Business Manager;
# names are set in config/sunates.php (messaging.whatsapp_templates).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Contact policy. Alumni imported from Registrar spreadsheets who have NOT registered have not been
# through the consent step, so by default they are neither surveyed nor nudged. Turn these on only
# after the data-protection review says the university may contact them for the tracer study.
SURVEY_INCLUDE_UNCLAIMED=false
NUDGES_INCLUDE_UNCLAIMED=false
NUDGES_ENABLED=true
# NUDGES_DAILY_LIMIT=200
# SURVEY_WINDOW_DAYS=90

# SorotiUniERP hook (FR-9). "none" = standalone: alumni come from Registrar spreadsheets and the daily sync does nothing.
# Once the ERP is live set rest or database, run "Test the connection" and "Preview" on the console's
# SorotiUniERP sync page, then let the daily sync (ERP_SYNC_AT, Uganda time) take over. See the README.
ERP_DRIVER=none
# ERP_SYNC_AT=02:30

# REST mode: the ERP's address must be https:// (the credential travels with every request).
# ERP_REST_BASE_URL=https://erp.soroti.ac.ug
# ERP_REST_PATH=/api/graduates
# ERP_REST_AUTH=bearer          # bearer | header | none
# ERP_REST_TOKEN=
# ERP_REST_TOKEN_HEADER=X-Api-Key
# ERP_REST_DATA_KEY=data        # where the list sits in the answer; empty if the answer is the list
# ERP_REST_SINCE_PARAM=updated_since
# ERP_REST_PAGE_PARAM=page
# ERP_REST_SIZE_PARAM=per_page
# ERP_REST_PAGE_SIZE=200

# Database mode: a read-only view of graduates, on a connection you add to config/database.php.
# ERP_DB_CONNECTION=erp
# ERP_DB_TABLE=sunates_graduates

# What the ERP calls our columns (JSON: our column -> the ERP's field; null = the ERP does not have it).
# ERP_FIELD_MAP='{"student_number":"regNo","first_name":"givenName","last_name":"familyName","programme":"course.name","status":"state","updated_at":"modifiedAt"}'

# Manual follow-up of non-responsive alumni (spec 7.4 fallback): days before the same person is suggested again.
# FOLLOWUP_RECHECK_AFTER_DAYS=180

