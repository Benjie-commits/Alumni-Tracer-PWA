<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run on MySQL (the production engine) against a dedicated database so RefreshDatabase never touches dev data. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="sunates_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- The SorotiUniERP hook is pinned to its defaults: a developer's real ERP settings in .env must never change what the tests see (or reach a real ERP). -->
        <env name="ERP_DRIVER" value="none"/>
        <env name="ERP_FIELD_MAP" value="[]"/>
        <env name="ERP_SYNC_AT" value="02:30"/>
        <env name="ERP_MAX_RECORDS" value="100000"/>
        <env name="ERP_REST_BASE_URL" value=""/>
        <env name="ERP_REST_PATH" value="/api/graduates"/>
        <env name="ERP_REST_AUTH" value="bearer"/>
        <env name="ERP_REST_TOKEN" value=""/>
        <env name="ERP_REST_TOKEN_HEADER" value="X-Api-Key"/>
        <env name="ERP_REST_DATA_KEY" value="data"/>
        <env name="ERP_REST_SINCE_PARAM" value="updated_since"/>
        <env name="ERP_REST_PAGE_PARAM" value="page"/>
        <env name="ERP_REST_SIZE_PARAM" value="per_page"/>
        <env name="ERP_REST_PAGE_SIZE" value="200"/>
        <env name="ERP_REST_TIMEOUT" value="30"/>
        <env name="ERP_DB_CONNECTION" value=""/>
        <env name="ERP_DB_TABLE" value="sunates_graduates"/>
        <env name="FOLLOWUP_RECHECK_AFTER_DAYS" value="180"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
